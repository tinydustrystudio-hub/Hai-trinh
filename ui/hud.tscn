[ext_resource type="PackedScene" path="res://ui/build_ring.tscn" id="3_ring"]
[ext_resource type="PackedScene" path="res://ui/upgrade_ring.tscn" id="4_upgrade"]
[ext_resource type="PackedScene" path="res://ui/branch_cards.tscn" id="5_branch"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="BuildRing" parent="." instance=ExtResource("3_ring")]

[node name="UpgradeRing" parent="." instance=ExtResource("4_upgrade")]

[node name="BranchCards" parent="." instance=ExtResource("5_branch")]

[node name="ResultPanel" parent="." instance=ExtResource("2_result")]
