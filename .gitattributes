# Chuẩn hoá xuống dòng cho file chữ
* text=auto eol=lf

# Git LFS cho model, ảnh, âm thanh, font
*.glb filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text

# Addon của bên thứ ba giữ ngoài LFS: CI chạy test mà không cần tải LFS,
# và không tốn hạn mức băng thông LFS
addons/** !filter !diff !merge
